APP_NAME=Universal Subtitle Translator
APP_VERSION=1.3.0
APP_HOST=0.0.0.0
APP_PORT=2288

# Never commit a real key. Put your local key in .env only.
OPENAI_API_KEY=REPLACE_YOUR_API_WITH_THIS_TEXT
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_COST_PER_1M=0
OPENAI_OUTPUT_COST_PER_1M=0

# Admin login is enabled by default, even without a local .env file.
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=default-insecure-session-secret-change-before-release

DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
OUTPUT_DIR=/app/data/outputs
TEMP_DIR=/app/data/temp
DATABASE_PATH=/app/data/app.db
MEDIA_ROOT=
NGINX_CLIENT_MAX_BODY_SIZE=10G

PROJECT_AUTHOR=Afshin Saberi
PROJECT_YEAR=2026
PROJECT_LICENSE=MIT
PROJECT_GITHUB_HANDLE=afshinsb
PROJECT_GITHUB_URL=https://github.com/afshinsb
PROJECT_ISSUE_URL=https://github.com/afshinsb
PROJECT_ABOUT_URL=/about

DEFAULT_STYLE=natural_conversational

SRT_BATCH_SIZE=40
SRT_MAX_CHARS=12000
BATCH_FILE_CONCURRENCY=10
MAX_UPLOAD_MB=10240
FFMPEG_TIMEOUT_SECONDS=120
OPENAI_TIMEOUT_SECONDS=120
