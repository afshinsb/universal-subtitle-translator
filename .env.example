APP_NAME=Universal Subtitle Translator
# APP_VERSION is supplied by the image; IMAGE_TAG selects the Docker release.
IMAGE_TAG=1.8.2
DEMO_MODE=false
APP_HOST=0.0.0.0
APP_PORT=2288
APP_BIND_HOST=127.0.0.1
# Linux bind-mount ownership: use the UID/GID that can write data and media.
PUID=1000
PGID=1000

# Never commit a real key. Put your local key in .env only.
OPENAI_API_KEY=REPLACE_YOUR_API_WITH_THIS_TEXT
OPENAI_MODEL=gpt-4o-mini
# Optional reasoning configuration; blank retains legacy sampling behavior.
OPENAI_REASONING_EFFORT=
# 0 leaves the provider default; reasoning and visible output share this limit.
OPENAI_MAX_COMPLETION_TOKENS=0
OPENAI_INPUT_COST_PER_1M=0
OPENAI_OUTPUT_COST_PER_1M=0

# Docker enforces secure auth settings. DEV_MODE=true is local development only.
DEV_MODE=false
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_YOUR_PASSWORD_WITH_THIS_TEXT
SESSION_SECRET=REPLACE_YOUR_SESSION_SECRET_WITH_THIS_TEXT
SESSION_HTTPS_ONLY=false

DATA_DIR=/app/data
UPLOAD_DIR=/app/data/uploads
OUTPUT_DIR=/app/data/outputs
TEMP_DIR=/app/data/temp
DATABASE_PATH=/app/data/app.db
# Optional Docker/Portainer media mount root, for example /media.
MEDIA_ROOT=
NGINX_CLIENT_MAX_BODY_SIZE=10G

PROJECT_AUTHOR=Afshin Saberi
PROJECT_YEAR=2026
PROJECT_LICENSE=MIT
PROJECT_GITHUB_HANDLE=afshinsb
PROJECT_GITHUB_URL=https://github.com/afshinsb/universal-subtitle-translator
PROJECT_ISSUE_URL=https://github.com/afshinsb/universal-subtitle-translator/issues
PROJECT_ABOUT_URL=/about

DEFAULT_STYLE=natural_conversational

SRT_BATCH_SIZE=40
SRT_MAX_CHARS=12000
BATCH_FILE_CONCURRENCY=10
MAX_UPLOAD_MB=10240
FFMPEG_TIMEOUT_SECONDS=120
OPENAI_TIMEOUT_SECONDS=120

# Optional durable UTC daily ceiling; 0 disables. Configure before automation approval.
OPENAI_DAILY_BUDGET_USD=0
# Conservative standard short-context input/cache-write and output rates.
OPENAI_BUDGET_INPUT_CEILING_PER_1M=0.125
OPENAI_BUDGET_OUTPUT_PER_1M=0.5
