# Copy to dev/.env, replace these values, and chmod 600 dev/.env.
ADMIN_USERNAME=prime-dev
ADMIN_PASSWORD=replace-with-random-development-password
SESSION_SECRET=replace-with-32-or-more-random-characters

# Optional provider: blank until configured; paid translation needs approval.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEFAULT_STYLE=natural_conversational
SRT_BATCH_SIZE=40
SRT_MAX_CHARS=12000
MAX_UPLOAD_MB=10240
NGINX_CLIENT_MAX_BODY_SIZE=10G
